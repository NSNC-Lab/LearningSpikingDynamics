+    )
+    new_dP = (
+        (1.0 - u * depression) * old_dP
+        - depression * forward_P * w
+    )
+    new_dx = old_dx + u * d_event_q + event_q * w
+    return new_dF, new_dP, new_dx, old_ds, d_event_q
+
